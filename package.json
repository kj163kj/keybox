{
  "name": "keybox-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:types": "node scripts/generate_api_types.mjs",
    "check:types-sync": "node scripts/generate_api_types.mjs --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --mode production && node scripts/check-production.mjs",
    "setup:preview": "node scripts/setup-preview.mjs",
    "dev:preview": "vite --mode preview --host 127.0.0.1",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "preview:local": "vite preview --mode preview --host 127.0.0.1 --port 8080 --strictPort",
    "check:production": "node scripts/check-production.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
