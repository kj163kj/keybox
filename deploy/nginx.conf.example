# Include in an HTTPS server block with your TLS configuration. Do not enable a
# CDN/cache on /api or record request bodies, cookies, authorization, or query args.
location /api/ {
    client_max_body_size 1088k;
    client_body_buffer_size 1088k;
    client_body_timeout 10s;
    proxy_request_buffering off;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 25s;
    proxy_send_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;
}
