# Required. Real secrets belong in a local .env, environment, or *_FILE secret
# mounts. No usable credentials or encryption keys are supplied here.
KEYBOX_DB_DSN=
KEYBOX_ACTIVE_KEY_ID=
KEYBOX_ENCRYPTION_KEYS=
KEYBOX_IP_HASH_KEY=
KEYBOX_CSRF_KEY=
KEYBOX_ALLOWED_ORIGINS=https://keybox.example.com
KEYBOX_TRUSTED_PROXIES=
KEYBOX_HTTP_ADDR=:8080
KEYBOX_MAX_FILE_BYTES=1048576
KEYBOX_UPLOADS_PER_IP_HOUR=10
KEYBOX_UPLOADS_GLOBAL_HOUR=100
KEYBOX_GUEST_DOWNLOADS_PER_IP_HOUR=5
KEYBOX_DOWNLOADS_GLOBAL_HOUR=100
KEYBOX_CRL_MAX_STALE=24h
# Docker Compose bootstrap only; API must use a separate runtime DB account.
MYSQL_ROOT_PASSWORD=
MYSQL_MIGRATOR_PASSWORD=
KEYBOX_MIGRATION_DSN=
